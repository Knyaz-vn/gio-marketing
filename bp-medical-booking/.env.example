# Скопіюйте у .env ПОЗА webroot (на рівень вище каталогу WordPress) або задайте BPMB_ENV_FILE у wp-config.php.
# Жодних ключів у репозиторії та в БД.

# Google service account: шлях до JSON-ключа (краще) або сам JSON / base64 в одному рядку
BPMB_GOOGLE_SA_FILE=/home/bpmedical/secrets/bp-booking-sa.json
# BPMB_GOOGLE_SA_JSON=eyJ0eXBlIjoic2VydmljZV9hY2NvdW50Iiwi...

# Telegram-бот для сповіщень адміністраторів (chat_id задається в адмінці)
BPMB_TELEGRAM_BOT_TOKEN=123456789:AA...

# Cloudflare Turnstile (необов'язково; site key задається в адмінці)
# BPMB_TURNSTILE_SECRET=0x4AAAA...
